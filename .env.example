NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_2jC7bMpnRdrUwlMz6WzmNw_eSybxTkv
# Chỉ dùng nếu project cũ chưa có Publishable key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ cần cho worker/admin task tương lai; web import hiện dùng session + RLS.
SUPABASE_SECRET_KEY=
# Legacy fallback cho project cũ; không đưa xuống browser:
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=
# Không bật Redis/queue nếu chưa triển khai worker riêng.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_REDIRECT_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# TopView AI video. API chỉ có trên gói Pro/Business; gói free không kèm API.
# Để trống thì Content Studio dùng luồng nhập video thủ công (miễn phí).
TOPVIEW_API_KEY=
TOPVIEW_API_BASE_URL=
# Xác nhận lại đường dẫn endpoint tại docs.topview.ai trước khi bật API path.
TOPVIEW_SUBMIT_PATH=
TOPVIEW_QUERY_PATH=
# Quy đổi 1 credit sang VNĐ để nạp vào contentCost; để trống thì chi phí ghi 0.
TOPVIEW_CREDIT_VND=
# Đăng tự động. YouTube Data API miễn phí (~100 video/ngày); tạo OAuth client
# trong Google Cloud Console, redirect URI: <APP_URL>/api/connect/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok chỉ đẩy được vào nháp (scope video.upload) khi app chưa qua audit.
# Redirect URI: <APP_URL>/api/connect/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Bắt buộc nếu muốn đăng bài ảnh lên TikTok: tiền tố URL thuộc domain bạn đã
# xác minh trong TikTok Developer Portal. Để trống thì bài ảnh bị khoá.
TIKTOK_VERIFIED_URL_PREFIX=
LOG_LEVEL=info

# ─── Tự nhập CSV từ thư mục (scripts/watch-imports.mjs) ───
# Tài khoản THƯỜNG bạn dùng để đăng nhập vào chính app này — không phải khoá
# service. Script cố ý đăng nhập như một người dùng bình thường để đi qua RLS,
# thay vì dùng khoá bỏ qua RLS cho tiện.
PROFITOS_EMAIL=
PROFITOS_PASSWORD=
